{
  "name": "in-the-void-android",
  "private": true,
  "version": "1.2.0",
  "description": "IN THE VOID Android application",
  "scripts": {
    "build:web": "node scripts/prepare-web.mjs",
    "android:prepare": "npm run build:web && npx cap add android && node scripts/prepare-android.mjs && npx cap sync android",
    "android:build": "npm run android:prepare && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@supabase/supabase-js": "^2.0.0",
    "jszip": "^3.0.0",
    "pdf-lib": "^1.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@capacitor/assets": "^3.0.5"
  }
}
